---
// Hero — Acte 0, « Ouverture ».
// Contenu : CLAUDE.md §3.2, qui fait toujours autorite.
// Forme : spec du 2026-09-14 — typographique, plus de scene WebGL.
//
// Le nom ouvre la page sans rien au-dessus, comme un titre d'affiche. Le
// prologue et la proposition de valeur sont regroupes en une seule bande
// sous le titre : empiles verticalement, ils lui volaient ~128px de hauteur
// et le forcaient a 53% de la largeur sur un ecran 1366x768.
import '../../styles/hero.css';
---

<section id="hero" class="section" data-act="0">
  <h1 class="hero-titre">
    <span class="ligne"><span>Enzo</span></span>
    <span class="ligne"><span>Couteau</span></span>
  </h1>

  <div class="hero-bas">
    <p class="hero-prologue">
      &laquo;&nbsp;Un site ne suffit plus à convaincre un client exigeant.&nbsp;&raquo;
    </p>

    <p class="hero-sub">
      Réalisateur &amp; développeur web — je transforme des projets ambitieux
      en expériences qu'on n'oublie pas, et qui convertissent.
    </p>

    <a class="hero-cue" href="#projets">
      Entrer en salle
      <span class="trait" aria-hidden="true"></span>
    </a>
  </div>
</section>
