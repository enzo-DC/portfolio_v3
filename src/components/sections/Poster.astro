---
// Poster — une affiche de la grille (spec : Acte I).
//
// C'est un <button> et non un <div> cliquable : l'element ouvre un dialogue,
// il doit donc etre annonce comme actionnable et recevoir le focus clavier
// nativement. `aria-haspopup="dialog"` annonce ce qui va se produire.
//
// Deux etats, un seul composant : tant qu'aucun `visuel` n'est fourni, on
// affiche le bloc de couleur et le numero. Deposer un fichier suffit a
// basculer sur le photogramme, sans toucher au code.
import type { Project } from '../../content/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;

// "Séance 01" -> "01" pour le bloc de repli.
const numero = project.index.match(/\d+/)?.[0] ?? '';
---

<button
  class="affiche"
  type="button"
  data-affiche={project.slug}
  aria-haspopup="dialog"
  aria-label={`Ouvrir le détail du projet ${project.title}`}
>
  <span class="affiche-cadre" data-cadre={project.slug}>
    {
      project.visuel ? (
        <img
          class="affiche-visuel"
          src={project.visuel}
          alt=""
          loading="lazy"
          decoding="async"
        />
      ) : (
        <span
          class="affiche-bloc"
          style={`--affiche-teinte: ${project.tint};`}
          aria-hidden="true"
        >
          <span>{numero}</span>
        </span>
      )
    }
  </span>

  <span class="affiche-legende">
    <span class="affiche-num">{project.index}</span>
    <span class="affiche-titre">{project.title}</span>
    <span class="affiche-role">{project.role}</span>
  </span>
</button>
