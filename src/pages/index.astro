---
// Page unique (spec du 2026-09-14). Quatre actes, scroll vertical.
// Le detail d'un projet s'ouvre en surimpression, sans quitter la page :
// l'objectif est la conversion, le formulaire doit rester a un scroll.
import BaseLayout from '../layouts/BaseLayout.astro';

import GrainOverlay from '../components/layout/GrainOverlay.astro';
import Topbar from '../components/layout/Topbar.astro';

import Hero from '../components/sections/Hero.astro';
import Projects from '../components/sections/Projects.astro';
import About from '../components/sections/About.astro';
import Contact from '../components/sections/Contact.astro';
import Credits from '../components/sections/Credits.astro';

import SmoothScrollProvider from '../components/islands/SmoothScrollProvider';
import SceneTransitions from '../components/islands/SceneTransitions';
---

<BaseLayout>
  <GrainOverlay />
  <Topbar />

  <main>
    <Hero />
    <Projects />
    <About />
    <Contact />
  </main>

  <Credits />

  <SmoothScrollProvider client:load />
  <SceneTransitions client:load />
</BaseLayout>
